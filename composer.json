{
  "name": "arena/tournament-platform",
  "type": "project",
  "description": "Tournament hosting platform with CS2 server operations",
  "require": { "php": "^8.2", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0" },
  "require-dev": { "fakerphp/faker": "^1.23", "laravel/pint": "^1.18" },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "scripts": { "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php tests/run.php" },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true }
}
