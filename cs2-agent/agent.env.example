# Put this file on the Linux host as agent.env and replace every placeholder.
CS2_AGENT_TOKEN=replace-with-the-same-random-secret-as-laravel
CS2_CALLBACK_TOKEN=replace-with-the-same-random-secret-as-laravel
CS2_DIR=/opt/cs2/server
CS2_SERVER_HOST=192.168.1.50
CS2_GAME_PORT=27015
CS2_AGENT_PORT=8787
CS2_CALLBACK_BASE=http://192.168.1.20:8000
CS2_STREAM_BASE=http://192.168.1.50:8889
# Optional for LAN testing; create a Game Server Login Token for App ID 730 if desired.
CS2_GSLT=
